{
  "name": "@pmcfernandes/auth",
  "version": "1.0.0",
  "type": "module",
  "description": "Reusable React component for email and password authentication.",
  "keywords": [
    "react",
    "login",
    "authentication",
    "form"
  ],
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/auth.cjs",
  "module": "./dist/auth.js",
  "exports": {
    ".": {
      "import": "./dist/auth.js",
      "require": "./dist/auth.cjs"
    },
    "./styles.css": "./dist/auth.css"
  },
  "scripts": {
    "dev": "npm --prefix samples run dev",
    "build": "vite build",
    "preview": "npm --prefix samples run preview"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "md5": "^2.3.0"
  }
}
