      { "key": "sku", "label": "SKU" },
      { "key": "color", "label": "Cor" },
      { "key": "stock", "label": "Stock", "type": "number" }
    ] } },
    { "key": "category", "label": "Categoria", "type": "select", "options": ["Eletrónica", "Casa", "Desporto"] },
    { "key": "price", "label": "Preço", "type": "currency", "currency": "EUR", "align": "right" },
    { "key": "stock", "label": "Stock", "type": "number", "align": "right" },
    { "key": "status", "label": "Estado", "type": "badge", "badgeMap": { "Ativo": "success", "Esgotado": "error", "Rascunho": "warning" } }
  ],
